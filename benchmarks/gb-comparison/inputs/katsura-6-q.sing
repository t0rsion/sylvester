system("--ticks-per-sec",1000);
ring r = 0,(x1,x2,x3,x4,x5,x6,x7),dp;
ideal I = x1+2*x2+2*x3+2*x4+2*x5+2*x6+2*x7-1,
  x1^2+2*x2^2+2*x3^2+2*x4^2+2*x5^2+2*x6^2+2*x7^2-x1,
  2*x1*x2+2*x2*x3+2*x3*x4+2*x4*x5+2*x5*x6+2*x6*x7-x2,
  x2^2+2*x1*x3+2*x2*x4+2*x3*x5+2*x4*x6+2*x5*x7-x3,
  2*x2*x3+2*x1*x4+2*x2*x5+2*x3*x6+2*x4*x7-x4,
  x3^2+2*x2*x4+2*x1*x5+2*x2*x6+2*x3*x7-x5,
  2*x3*x4+2*x2*x5+2*x1*x6+2*x2*x7-x6;
option(redSB);
int t0 = rtimer;
ideal G = simplify(std(I), 1);
int t1 = rtimer;
print("TIME_MS "+string(t1-t0));
print("SIZE "+string(size(G)));
int i;
for (i=1; i<=size(G); i++) { print("LM "+string(leadmonom(G[i]))); }
for (i=1; i<=size(G); i++) { print("POLY "+string(G[i])); }
exit;
