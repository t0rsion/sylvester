system("--ticks-per-sec",1000);
ring r = 1073741827,(x1,x2,x3,x4,x5,x6),dp;
ideal I = x1+2*x2+2*x3+2*x4+2*x5+2*x6-1,
  x1^2+2*x2^2+2*x3^2+2*x4^2+2*x5^2+2*x6^2-x1,
  2*x1*x2+2*x2*x3+2*x3*x4+2*x4*x5+2*x5*x6-x2,
  x2^2+2*x1*x3+2*x2*x4+2*x3*x5+2*x4*x6-x3,
  2*x2*x3+2*x1*x4+2*x2*x5+2*x3*x6-x4,
  x3^2+2*x2*x4+2*x1*x5+2*x2*x6-x5;
option(redSB);
int t0 = rtimer;
ideal G = std(I);
int t1 = rtimer;
print("TIME_MS "+string(t1-t0));
print("SIZE "+string(size(G)));
int i;
for (i=1; i<=size(G); i++) { print("LM "+string(leadmonom(G[i]))); }
for (i=1; i<=size(G); i++) { print("POLY "+string(G[i])); }
exit;
